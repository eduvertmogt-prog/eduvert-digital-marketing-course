# Copy to .env (never commit .env) for local database work.
#
# Use the POOLED connection string from the Neon dashboard
# (the hostname contains "-pooler"). The serverless HTTP driver
# this project uses benefits from pooling, and pooled strings are
# what work reliably from Cloudflare Workers.
#
# Row-level access is intentionally wide here: this string is for
# local scripts and migrations only. Production MUST use a Worker
# secret instead (see docs/DATABASE.md) — never bake this value
# into source, config files, or client-side code.

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
